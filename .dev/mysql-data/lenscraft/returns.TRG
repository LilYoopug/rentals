TYPE=TRIGGERS
triggers='CREATE DEFINER=`root`@`localhost` TRIGGER trg_returns_before_insert\nBEFORE INSERT ON returns\nFOR EACH ROW\nBEGIN\n    IF NEW.status = \'completed\' AND NEW.returned_at IS NULL THEN\n        SET NEW.returned_at = NOW();\n    END IF;\nEND' 'CREATE DEFINER=`root`@`localhost` TRIGGER trg_returns_after_insert\nAFTER INSERT ON returns\nFOR EACH ROW\nBEGIN\n    IF NEW.status = \'completed\' THEN\n        UPDATE rentals\n        SET status = \'completed\',\n            completed_at = COALESCE(NEW.returned_at, NOW())\n        WHERE id = NEW.rental_id\n          AND status <> \'completed\';\n    END IF;\nEND' 'CREATE DEFINER=`root`@`localhost` TRIGGER trg_returns_before_update\nBEFORE UPDATE ON returns\nFOR EACH ROW\nBEGIN\n    IF NEW.status = \'completed\' AND NEW.returned_at IS NULL THEN\n        SET NEW.returned_at = COALESCE(OLD.returned_at, NOW());\n    END IF;\nEND' 'CREATE DEFINER=`root`@`localhost` TRIGGER trg_returns_after_update\nAFTER UPDATE ON returns\nFOR EACH ROW\nBEGIN\n    IF NEW.status = \'completed\' AND OLD.status <> \'completed\' THEN\n        UPDATE rentals\n        SET status = \'completed\',\n            completed_at = COALESCE(NEW.returned_at, NOW())\n        WHERE id = NEW.rental_id\n          AND status <> \'completed\';\n    END IF;\nEND'
