TYPE=TRIGGERS
triggers='CREATE DEFINER=`root`@`localhost` TRIGGER trg_returns_before_insert\nBEFORE INSERT ON returns\nFOR EACH ROW\nBEGIN\n    DECLARE rental_end_date DATE DEFAULT NULL;\n    DECLARE rental_daily_rate DECIMAL(10,2) DEFAULT 0;\n\n    IF NEW.status IN (\'selesai\', \'completed\') AND NEW.returned_at IS NULL THEN\n        SET NEW.returned_at = NOW();\n    END IF;\n\n    SELECT end_date, daily_rate\n    INTO rental_end_date, rental_daily_rate\n    FROM rentals\n    WHERE id = NEW.rental_id\n    LIMIT 1;\n\n    IF NEW.status IN (\'selesai\', \'completed\') AND rental_end_date IS NOT NULL THEN\n        SET NEW.fine_amount = GREATEST(DATEDIFF(DATE(NEW.returned_at), rental_end_date), 0) * rental_daily_rate;\n    ELSE\n        SET NEW.fine_amount = 0;\n    END IF;\nEND' 'CREATE DEFINER=`root`@`localhost` TRIGGER trg_returns_after_insert\nAFTER INSERT ON returns\nFOR EACH ROW\nBEGIN\n    IF NEW.status = \'completed\' THEN\n        UPDATE rentals\n        SET status = \'completed\',\n            completed_at = COALESCE(NEW.returned_at, NOW())\n        WHERE id = NEW.rental_id\n          AND status <> \'completed\';\n    END IF;\nEND' 'CREATE DEFINER=`root`@`localhost` TRIGGER trg_returns_before_update\nBEFORE UPDATE ON returns\nFOR EACH ROW\nBEGIN\n    DECLARE rental_end_date DATE DEFAULT NULL;\n    DECLARE rental_daily_rate DECIMAL(10,2) DEFAULT 0;\n\n    IF NEW.status IN (\'selesai\', \'completed\') AND NEW.returned_at IS NULL THEN\n        SET NEW.returned_at = COALESCE(OLD.returned_at, NOW());\n    END IF;\n\n    SELECT end_date, daily_rate\n    INTO rental_end_date, rental_daily_rate\n    FROM rentals\n    WHERE id = NEW.rental_id\n    LIMIT 1;\n\n    IF NEW.status IN (\'selesai\', \'completed\') AND rental_end_date IS NOT NULL THEN\n        SET NEW.fine_amount = GREATEST(DATEDIFF(DATE(NEW.returned_at), rental_end_date), 0) * rental_daily_rate;\n    ELSE\n        SET NEW.fine_amount = 0;\n    END IF;\nEND' 'CREATE DEFINER=`root`@`localhost` TRIGGER trg_returns_after_update\nAFTER UPDATE ON returns\nFOR EACH ROW\nBEGIN\n    IF NEW.status = \'completed\' AND OLD.status <> \'completed\' THEN\n        UPDATE rentals\n        SET status = \'completed\',\n            completed_at = COALESCE(NEW.returned_at, NOW())\n        WHERE id = NEW.rental_id\n          AND status <> \'completed\';\n    END IF;\nEND'
