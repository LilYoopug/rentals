flowchart TD
    Start([mulai]) --> A[/staff/stock-price.php/]
    A --> B[toggle "Mode Edit" ON]
    B --> C[table rows become editable]
    C --> D[edit fields:<br/>harga, diskon, stok]
    D --> E[click "Save" floating button]
    E --> F[POST bulk-update.php]
    F --> G{success?}
    G -->|no| H[show error toast]
    G -->|yes| I[show success toast<br/>edit mode OFF]
    H --> A
    I --> A
    A --> Selesai([selesai])
