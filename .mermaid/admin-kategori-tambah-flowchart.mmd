flowchart TD
    Start([mulai]) --> A[/admin/categories.php/]
    A --> B[click tambah kategori]
    B --> C[popup modal<br/>input: nama, deskripsi,<br/>icon, warna, status]
    C --> D[submit form]
    D --> E[validasi data]
    E -->|gagal| F[show error]
    E -->|sukses| G[create category]
    G -->|gagal| F
    G -->|sukses| H[show success]
    F --> I[/admin/categories.php/]
    H --> I
    I --> Selesai([selesai])
