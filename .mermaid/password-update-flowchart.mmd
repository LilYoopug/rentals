flowchart TD
    Start([mulai]) --> A[/user/profile.php/]
    A --> B[scroll to "Keamanan"]
    B --> C[input: sandi saat ini,<br/>sandi baru, konfirmasi]
    C --> D[submit form]
    D --> E[verifikasi sandi saat ini]
    E -->|gagal| F[show error]
    E -->|sukses| G[validasi sandi baru]
    G -->|gagal| F
    G -->|sukses| H[update kata sandi]
    H -->|gagal| F
    H -->|sukses| I[log aktivitas]
    I --> J[show success]
    F --> K[/user/profile.php/]
    J --> K
    K --> Selesai([selesai])
