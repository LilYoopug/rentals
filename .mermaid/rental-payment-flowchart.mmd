flowchart TD
    Start([mulai]) --> A[/user/rentals.php/]
    A --> B[click "Bayar Sekarang"]
    B --> C[/user/payment.php/]
    C --> D[pilih metode pembayaran]
    D --> E{metode?}
    E -->|transfer/qris| F[show instruksi]
    E -->|kartu kredit| G[input kartu:<br/>nomor, expiry, CVV]
    F --> H[ajax POST<br/>rental-payment-process.php]
    G --> H
    H --> I{success?}
    I -->|no| J[show error toast]
    I -->|yes| K[update rental > aktif]
    K --> L[show success toast]
    J --> M[/user/rentals.php/]
    L --> M
    M --> Selesai([selesai])
